# PostgreSQL (ne jamais committer le vrai fichier .env)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plateforme_etudiante?schema=public"

# Authentification
JWT_SECRET="remplace-moi-par-un-secret-long-et-aleatoire"
JWT_EXPIRES_IN="15m"
ADMIN_BOOTSTRAP_SECRET="generate-a-long-random-one-time-secret"

# Frontends autorisés par CORS (séparés par des virgules)
FRONTEND_ORIGINS="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
PORT=3001

# Envoi des liens de vérification et de réinitialisation
SMTP_HOST="127.0.0.1"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="GPI <no-reply@localhost>"
