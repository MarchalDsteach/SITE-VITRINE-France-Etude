generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum Role {
  STUDENT
  ADVISOR
  ADMIN
}

enum LeadSource {
  CONTACT_FORM
  QUICK_REQUEST
  SERVICE_REQUEST
  APPLICATION
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
}

enum ApplicationType {
  AVI
  ADL
  CAMPUS_FRANCE
  SCHOLARSHIP
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  PAYMENT_PENDING
  PAID
  IN_REVIEW
  APPROVED
  DELIVERED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  country       String?
  originCountry String?
  role          Role          @default(STUDENT)
  status        AccountStatus @default(PENDING)
  emailVerified Boolean       @default(false)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  lastSeenAt    DateTime      @default(now())
  applications  Application[]
  offers        Offer[]       @relation("OfferAuthor")
  sentMessages  Message[]     @relation("SentMessages")
  receivedMessages Message[]  @relation("ReceivedMessages")
  assignedLeads Lead[]       @relation("AdvisorLeads")
  createdLeads  Lead[]       @relation("UserLeads")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([emailVerificationTokenHash])
  @@index([passwordResetTokenHash])
}

model Message {
  id          String   @id @default(cuid())
  subject     String
  body        String
  isRead      Boolean  @default(false)
  senderId    String
  recipientId String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
}

enum OfferType {
  ALTERNANCE
  INTERNSHIP
  STUDENT_JOB
}

model Lead {
  id             String      @id @default(cuid())
  fullName       String?
  email          String?
  phone          String?
  subject        String?
  source         LeadSource  @default(CONTACT_FORM)
  status         LeadStatus  @default(NEW)
  priority       LeadPriority @default(NORMAL)
  message        String?
  serviceName    String?
  country        String?
  userId         String?
  user           User?       @relation("UserLeads", fields: [userId], references: [id], onDelete: SetNull)
  advisorId      String?
  advisor        User?       @relation("AdvisorLeads", fields: [advisorId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([advisorId, createdAt])
}

model Offer {
  id           String   @id @default(cuid())
  title        String
  company      String
  location     String
  contractType String   @default("Alternance")
  type         OfferType @default(ALTERNANCE)
  duration     String?
  description  String
  requirements String?
  applyUrl     String?
  isPublished  Boolean  @default(false)
  publishedAt  DateTime?
  applicationClicks Int @default(0)
  lastClickedAt DateTime?
  authorId     String
  author       User     @relation("OfferAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

model Application {
  id          String            @id @default(cuid())
  reference   String            @unique
  type        ApplicationType
  status      ApplicationStatus @default(DRAFT)
  formData    Json
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   Document[]
  payments    Payment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Document {
  id            String      @id @default(cuid())
  name          String
  storageKey    String      @unique
  mimeType      String
  size          Int
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}

model Payment {
  id              String        @id @default(cuid())
  provider        String
  providerPaymentId String?     @unique
  amount          Int
  currency        String        @default("EUR")
  status          PaymentStatus @default(PENDING)
  applicationId   String
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
